NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# APP_VERSION is injected into production images from the Git commit SHA.
# APP_VERSION=development
DATABASE_URL=postgresql://nox:nox@localhost:5432/nox
PERSISTENCE_DRIVER=in-memory
RUN_DATABASE_MIGRATIONS=false
# DATABASE_MIGRATIONS_PATH=/app/migrations
OPENROUTER_API_KEY=
# Backward-compatible fallback for MODEL_DEFAULT.
OPENROUTER_MODEL=openai/gpt-5.6-luna
MODEL_FAST=openai/gpt-5.6-luna
MODEL_DEFAULT=openai/gpt-5.6-luna
MODEL_REASONING=openai/gpt-5.6-terra
MODEL_CODING=openai/gpt-5.6-sol
MODEL_FAST_REASONING_EFFORT=none
MODEL_DEFAULT_REASONING_EFFORT=low
MODEL_REASONING_REASONING_EFFORT=high
MODEL_CODING_REASONING_EFFORT=high
# MODEL_VISION=
# MODEL_MEMORY=
MODEL_STT=openai/gpt-4o-mini-transcribe
MODEL_TTS=hexgrad/kokoro-82m
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=NOX
NOX_API_TOKEN=replace-with-at-least-32-random-characters
NOX_USER_ID=owner
NOX_DEVICE_ID=primary
CLIMATE_DRIVER=mock
# Required only when CLIMATE_DRIVER=bridge. Use a different random secret from NOX_API_TOKEN.
# NOX_DEVICE_BRIDGE_TOKEN=replace-with-another-at-least-32-character-secret
NOX_DEVICE_BRIDGE_ID=home
NOX_CLIMATE_DEVICE_ID=home-ac
DEVICE_BRIDGE_COMMAND_TIMEOUT_MS=45000
DEVICE_BRIDGE_LONG_POLL_MS=25000
ACTION_TOOLS_AUTO_ALLOWED=false
CONFIRMATION_TTL_SECONDS=300
CONVERSATION_CONTEXT_MESSAGES=20
VOICE_LANGUAGE=pt
VOICE_TTS_VOICE=pf_dora
# Kept below nginx's 2 MiB request limit, including multipart overhead.
VOICE_MAX_UPLOAD_BYTES=2000000
VOICE_MAX_TTS_CHARACTERS=4000
