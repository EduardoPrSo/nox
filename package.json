{
  "name": "nox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "tsc --noEmit && tsup apps/api/src/server.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader runner",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:persistence": "tsx scripts/verify-persistence.ts",
    "verify:voice": "tsx scripts/verify-voice.ts",
    "verify:voice:provider": "tsx scripts/verify-voice-provider.ts",
    "verify:eko": "tsx scripts/verify-eko.ts",
    "verify:memory:provider": "tsx scripts/verify-memory-provider.ts",
    "benchmark:models": "tsx scripts/benchmark-models.ts",
    "benchmark:voice": "tsx scripts/benchmark-voice.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.5.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.17.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
